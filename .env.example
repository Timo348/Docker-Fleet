# Compose-only settings. Application settings belong in runtime/config/config.yml.
FLEET_IMAGE=timo348/docker-fleet:1.0.0
PROXY_NETWORK=proxy
CONFIG_NAME=config.yml
# Replace on the Docker host: stat -c '%g' /var/run/docker.sock
DOCKER_GID=replace-with-docker-socket-group-id
DOCKER_SOCKET_PATH=/var/run/docker.sock
LOCAL_HOST_ID=host-1
APP_TLS_NAME=fleet-server
LOCAL_AGENT_TLS_NAME=local-agent
LOCAL_AGENT_CLIENT_NAMES=fleet-backend-local-agent

# The separate agent template requires installation-specific values.
# AGENT_HOST_ID=host-2
# AGENT_BIND_ADDRESS=replace-with-private-host-address
# AGENT_PUBLISHED_PORT=9443
# AGENT_TLS_NAME=replace-with-agent-dns-name
# AGENT_ALLOWED_CLIENT_NAMES=fleet-backend-host-2
